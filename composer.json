    "type": "klxm-studio-extension",
    "license": "MIT",
    "keywords": ["klxm-studio", "klxm-studio-extension", "pdf", "dompdf"],
    "homepage": "https://studio.klxm.de",
    "authors": [{ "name": "KLXM Crossmedia GmbH and contributors" }],
    "require": { "php": ">=8.4.1", "dompdf/dompdf": "^3.1" },
    "extra": { "klxm-studio": { "entry": "extension.php", "requires-core": ">=1.0.0" } }
}
